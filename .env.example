# Copy this file to .env before starting the application.
POSTGRES_DB=parakh
POSTGRES_USER=parakh
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://parakh:replace-with-a-local-password@localhost:5432/parakh
REDIS_URL=redis://localhost:6379/0
# Generate a random secret for local development; never use this example value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:8000"]
ENVIRONMENT=development
PARAKH_SDK_KEY=
